{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["lhr1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    {
      "source": "/recipes/:id(\\d+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|Slackbot|TelegramBot|Discordbot|LinkedInBot|SkypeUriPreview|Viber|redditbot|Pinterest|Iframely|Embedly|vkShare|Google-PageRenderer).*"
        }
      ],
      "destination": "/api/index"
    },
    {
      "source": "/recipes/:id(\\d+)/zakupy",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|Slackbot|TelegramBot|Discordbot|LinkedInBot|SkypeUriPreview|Viber|redditbot|Pinterest|Iframely|Embedly|vkShare|Google-PageRenderer).*"
        }
      ],
      "destination": "/api/index"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] && exit 1 || exit 0",
  "installCommand": "pnpm -C web install",
  "buildCommand": "pnpm -C web run build",
  "outputDirectory": "web/dist"
}
